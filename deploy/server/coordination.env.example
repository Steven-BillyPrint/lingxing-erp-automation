ERP_AUTOMATION_HOME=/runtime
ERP_AUTOMATION_HOST_KEY_FILE=/run/secrets/host-key
ERP_COORDINATION_TOKEN_FILE=/run/secrets/api-token
ERP_COORDINATION_BIND=127.0.0.1
ERP_COORDINATION_PORT=18765
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ERP_AUTOMATION_HEADLESS=1
ERP_REQUIRED_CLIENT_VERSION_FILE=/app/CLIENT_VERSION
ERP_ROLLOUT_PREVIOUS_CLIENT_VERSION_FILE=/run/secrets/previous-client-version
ERP_CLIENT_ROLLOUT_GRACE_SECONDS=900
ERP_CLIENT_ROLLOUT_GRACE_DEADLINE_FILE=/run/secrets/client-rollout-deadline
ERP_REQUIRE_CLOUDFLARE_ACCESS=1
ERP_CLOUDFLARE_ACCESS_TEAM_DOMAIN=morning-leaf-e9e2.cloudflareaccess.com
ERP_CLOUDFLARE_ACCESS_AUDIENCE_FILE=/run/secrets/cloudflare-access-audience
ERP_CLOUDFLARE_ALLOWED_EMAIL_DOMAIN=billyprint.com
ERP_BOOTSTRAP_OPERATOR_EMAIL_FILE=/run/secrets/bootstrap-operator-email
